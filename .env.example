# Konfigurasi Database (Default SQLite untuk kemudahan local development & portability)
# Format SQLite: "file:./dev.db"
# Format MySQL (Laragon): "mysql://root:@localhost:3306/pertanian_cirebon_girang"
DATABASE_URL="file:./dev.db"

# Konfigurasi Aplikasi
APP_NAME="Platform Pertanian Padi Desa Cirebon Girang"
APP_ENV="development"
APP_URL="http://localhost:3000"

# Session Secret (WAJIB: Ganti dengan string acak minimal 32 karakter)
# Generate di terminal: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# AI Assistant - Konfigurasi Provider
# AI_PROVIDER: "gemini" atau "openai"
AI_PROVIDER="gemini"

# Isi dengan API Key sesuai provider yang dipilih
# Gemini: https://aistudio.google.com/apikey
# OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=""

# Model yang digunakan (opsional, ada default-nya)
# Gemini default: gemini-2.0-flash
# OpenAI default: gpt-4o-mini
AI_GEMINI_MODEL="gemini-2.0-flash"
AI_OPENAI_MODEL="gpt-4o-mini"

# Konfigurasi Notifikasi Email
NOTIFICATION_TARGET_EMAIL="karismasitinabila7@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="SI PADI"
SMTP_FROM_EMAIL="notifikasi@cirebongirang.desa.id"
